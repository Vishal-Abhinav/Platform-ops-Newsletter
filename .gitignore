# Python bytecode from the tools/ builders. Nine of these were committed and
# churned on every build; the whole repo deploys to Pages, so they were also
# nine public URLs serving compiled bytecode.
__pycache__/
*.py[cod]

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Local scratch — anything staged for inspection rather than publication
*.bak

# git filter-branch scratch. The whole repo deploys to Pages, so keep any
# rewrite leftovers out of a commit.
.git-rewrite/

# Build caches for the two scripts that are NOT part of build.sh.
# make_og_card.py needs the three webfonts; make_arch_svg.py needs Mermaid,
# which is ~3 MB on its own. Both are inputs to a manual regeneration step,
# not site content — and the whole repo deploys to Pages, so a committed
# cache is also a public URL, the same mistake as the bytecode above.
tools/.fontcache/
tools/.mermaid/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Build output -- not source.
# tools/build.sh wipes and rebuilds dist/ from content/, static/ and the
# generators on every run, and CI rebuilds it from scratch on every push
# before deploying. A committed copy is therefore a second source of
# truth that can only ever drift, and it turned every one-word content
# edit into an 800-file diff that buried the real change.
dist/
